import SwiftUI
struct EquipmentManagementView: View {
    @ObservedObject var manager: EquipmentManager
    @Environment(\.dismiss) var dismiss

    let equipment: Equipment?

@State private var id = "", name = "", manufacturer = "", purchaseYear = ""
@State private var selectedType: EquipmentType = .laptop

@State private var processor = "", ram = "", storage = ""
@State private var screenSize = "", batteryCapacity = ""
@State private var supportsStylus = false

@State private var sensorResolution = "", cameraType = "", videoResolution = ""

@State private var message = "", showAlert = false, shouldDismiss = false

    init(manager: EquipmentManager, equipment: Equipment? = nil) {
        self.manager = manager
        self.equipment = equipment

        _id = State(initialValue: equipment?.id ?? "")
        _name = State(initialValue: equipment?.name ?? "")
        _manufacturer = State(initialValue: equipment?.manufacturer ?? "")
        _purchaseYear = State(initialValue: equipment.map { String($0.purchaseYear) } ?? "")
        _selectedType = State(initialValue: equipment?.type ?? .laptop)

        if let laptop = equipment as? Laptop {
            _processor = State(initialValue: laptop.processor)
            _ram = State(initialValue: laptop.ram)
            _storage = State(initialValue: laptop.storage)
        } else if let tablet = equipment as? Tablet {
            _screenSize = State(initialValue: tablet.screenSize)
            _batteryCapacity = State(initialValue: tablet.batteryCapacity)
            _supportsStylus = State(initialValue: tablet.supportsStylus)
        } else if let camera = equipment as? DigitalCamera {
            _sensorResolution = State(initialValue: camera.sensorResolution)
            _cameraType = State(initialValue: camera.cameraType)
            _videoResolution = State(initialValue: camera.videoResolution)
        }
    }

    var body: some View {
        Form {
            Section(header: Text("General Information")) {
                TextField("Equipment ID", text: $id)
                    .disabled(equipment != nil)

                TextField("Equipment Name", text: $name)
                TextField("Manufacturer", text: $manufacturer)

                TextField("Purchase Year", text: $purchaseYear)
                    .keyboardType(.numberPad)
                    .disabled(equipment != nil)

                Picker("Equipment Type", selection: $selectedType) {
                    ForEach(EquipmentType.allCases) { type in
                        Text(type.rawValue).tag(type)
                    }
                }
                .disabled(equipment != nil)
            }

            Section(header: Text("Specific Information")) {
                if selectedType == .laptop {
                    TextField("Processor", text: $processor)
                    TextField("RAM", text: $ram)
                    TextField("Storage", text: $storage)
                } else if selectedType == .tablet {
                    TextField("Screen Size", text: $screenSize)
                    TextField("Battery Capacity", text: $batteryCapacity)
                    Toggle("Supports Stylus", isOn: $supportsStylus)
                } else {
                    TextField("Sensor Resolution", text: $sensorResolution)
                    TextField("Camera Type", text: $cameraType)
                    TextField("Video Resolution", text: $videoResolution)
                }
            }

            Section {
                Button(equipment == nil ? "Add Equipment" : "Save Changes") {
                    saveEquipment()
                }
            }
        }
        .navigationTitle(equipment == nil ? "Add Equipment" : "Edit Equipment")
        .alert("Notification", isPresented: $showAlert) {
            Button("OK") {
                if shouldDismiss { dismiss() }
            }
        } message: {
            Text(message)
        }
    }
}

// 
   func saveEquipment() {
    guard let year = Int(purchaseYear), year > 0 else {
        message = "Please enter a valid purchase year."
        showAlert = true
        return
    }

    if let equipment = equipment {
        let result = manager.updateEquipment(
            equipment, name: name, manufacturer: manufacturer,
            processor: processor, ram: ram, storage: storage,
            screenSize: screenSize, batteryCapacity: batteryCapacity,
            supportsStylus: supportsStylus,
            sensorResolution: sensorResolution,
            cameraType: cameraType, videoResolution: videoResolution
        )

        message = result ?? "Equipment updated successfully!"
        shouldDismiss = (result == nil)

    } else {
        let newEquipment: Equipment

        switch selectedType {
        case .laptop:
            newEquipment = Laptop(
                id: id, name: name, manufacturer: manufacturer,
                purchaseYear: year, processor: processor,
                ram: ram, storage: storage
            )

        case .tablet:
            newEquipment = Tablet(
                id: id, name: name, manufacturer: manufacturer,
                purchaseYear: year, screenSize: screenSize,
                batteryCapacity: batteryCapacity,
                supportsStylus: supportsStylus
            )

        case .digitalCamera:
            newEquipment = DigitalCamera(
                id: id, name: name, manufacturer: manufacturer,
                purchaseYear: year, sensorResolution: sensorResolution,
                cameraType: cameraType, videoResolution: videoResolution
            )
        }

        let result = manager.addEquipment(newEquipment)
        message = result ?? "Equipment added successfully!"
        shouldDismiss = (result == nil)
    }

    showAlert = true
}

