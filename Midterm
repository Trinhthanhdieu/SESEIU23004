import SwiftUI
struct EquipmentDetailView: View {
    @ObservedObject var equipment: Equipment
    @ObservedObject var manager: EquipmentManager

    @State private var borrowerName = ""
    @State private var message = ""
    @State private var showAlert = false

    var body: some View {
        Form {
            Section(header: Text("Equipment Information")) {
                Text("ID: \(equipment.id)")
                Text("Name: \(equipment.name)")
                Text("Manufacturer: \(equipment.manufacturer)")
                Text("Purchase Year: \(equipment.purchaseYear)")
                Text("Type: \(equipment.type.rawValue)")
                Text("Status: \(equipment.isAvailable ? "Available" : "Borrowed")")
            }

            Section(header: Text("Specific Information")) {
                if let laptop = equipment as? Laptop {
                    Text("Processor: \(laptop.processor)")
                    Text("RAM: \(laptop.ram)")
                    Text("Storage: \(laptop.storage)")
                } else if let tablet = equipment as? Tablet {
                    Text("Screen: \(tablet.screenSize)")
                    Text("Battery: \(tablet.batteryCapacity)")
                    Text("Stylus: \(tablet.supportsStylus ? "Yes" : "No")")
                } else if let camera = equipment as? DigitalCamera {
                    Text("Resolution: \(camera.sensorResolution)")
                    Text("Camera Type: \(camera.cameraType)")
                    Text("Video: \(camera.videoResolution)")
                }
            }

            Section(header: Text("Borrowing")) {
                if equipment.isAvailable {
                    TextField("Borrower Name", text: $borrowerName)

                    Button("Borrow Equipment") {
                        let result = manager.borrowEquipment(
                            equipmentID: equipment.id,
                            borrowerName: borrowerName
                        )

                        message = result ?? "Borrowing successful!"
                        if result == nil { borrowerName = "" }
                        showAlert = true
                    }
                } else {
                    Button("Return Equipment") {
                        let result = manager.returnEquipment(
                            equipmentID: equipment.id
                        )

                        message = result ?? "Return successful!"
                        showAlert = true
                    }
                }
            }

            Section {
                NavigationLink("Edit Equipment") {
                    EquipmentManagementView(
                        manager: manager,
                        equipment: equipment
                    )
                }
            }
        }
        .navigationTitle("Equipment Details")
        .alert("Notification", isPresented: $showAlert) {
            Button("OK", role: .cancel) { }
        } message: {
            Text(message)
        }
    }
}

