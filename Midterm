import Foundation
import Combine

class EquipmentManager: ObservableObject {
    @Published var equipments: [Equipment] = [
        Laptop(id: "L001", name: "MacBook Pro 14", manufacturer: "Apple",
               purchaseYear: 2024, processor: "M3", ram: "16GB", storage: "512GB"),

        Tablet(id: "T001", name: "iPad Air", manufacturer: "Apple",
               purchaseYear: 2023, screenSize: "11 inch",
               batteryCapacity: "7600 mAh", supportsStylus: true),

        DigitalCamera(id: "C001", name: "Canon EOS R50", manufacturer: "Canon",
                      purchaseYear: 2024, sensorResolution: "24MP",
                      cameraType: "Mirrorless", videoResolution: "4K")
    ]

    @Published var borrowRecords: [BorrowRecord] = []
}

//
func findEquipment(id: String) -> Equipment? {
    equipments.first { $0.id == id }
}

//
    func addEquipment(_ equipment: Equipment) -> String? {
    if equipment.id.trimmingCharacters(in: .whitespaces).isEmpty ||
       equipment.name.trimmingCharacters(in: .whitespaces).isEmpty ||
       equipment.manufacturer.trimmingCharacters(in: .whitespaces).isEmpty {
        return "Please fill in all information."
    }

    if findEquipment(id: equipment.id) != nil {
        return "Equipment ID already exists."
    }

    equipments.append(equipment)
    return nil
}

//
    func updateEquipment(
    _ equipment: Equipment, name: String, manufacturer: String,
    processor: String, ram: String, storage: String,
    screenSize: String, batteryCapacity: String, supportsStylus: Bool,
    sensorResolution: String, cameraType: String, videoResolution: String
) -> String? {

    guard findEquipment(id: equipment.id) != nil else {
        return "Equipment does not exist."
    }

    if name.trimmingCharacters(in: .whitespaces).isEmpty ||
       manufacturer.trimmingCharacters(in: .whitespaces).isEmpty {
        return "Please fill in all information."
    }

    equipment.name = name
    equipment.manufacturer = manufacturer

    if let laptop = equipment as? Laptop {
        laptop.processor = processor
        laptop.ram = ram
        laptop.storage = storage
    } else if let tablet = equipment as? Tablet {
        tablet.screenSize = screenSize
        tablet.batteryCapacity = batteryCapacity
        tablet.supportsStylus = supportsStylus
    } else if let camera = equipment as? DigitalCamera {
        camera.sensorResolution = sensorResolution
        camera.cameraType = cameraType
        camera.videoResolution = videoResolution
    }

    return nil
}

//
    func borrowEquipment(equipmentID: String, borrowerName: String) -> String? {
    guard let equipment = findEquipment(id: equipmentID) else {
        return "Equipment not found."
    }

    if borrowerName.trimmingCharacters(in: .whitespaces).isEmpty {
        return "Please enter borrower name."
    }

    if !equipment.isAvailable {
        return "Equipment is already borrowed."
    }

    if borrowRecords.contains(where: {
        $0.equipmentID == equipmentID && !$0.isReturned
    }) {
        return "Equipment already has an active record."
    }

    borrowRecords.append(BorrowRecord(
        equipmentID: equipmentID,
        borrowerName: borrowerName
    ))

    equipment.isAvailable = false
    return nil
}

//
func returnEquipment(equipmentID: String) -> String? {
    guard let equipment = findEquipment(id: equipmentID) else {
        return "Equipment not found."
    }

    if equipment.isAvailable {
        return "This equipment has not been borrowed."
    }

    guard let index = borrowRecords.firstIndex(where: {
        $0.equipmentID == equipmentID && !$0.isReturned
    }) else {
        return "No active borrowing record found."
    }

    borrowRecords[index].isReturned = true
    borrowRecords[index].returnDate = Date()
    equipment.isAvailable = true
    return nil
}


